---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Services from '../components/Services.astro'
import About from '../components/About.astro'
import Faq from '../components/Faq.astro'
import Contact from '../components/Contact.astro'
import { business, locales, routes, type Locale, type PageKind } from '../content'

// Every page of every language is generated from the route list in src/content/index.ts.
export function getStaticPaths() {
  return routes.map((route) => ({
    params: { slug: route.path.replace(/^\/|\/$/g, '') || undefined },
    props: { locale: route.locale, kind: route.kind },
  }))
}

interface Props {
  locale: Locale
  kind: PageKind
}

const { locale, kind } = Astro.props
const t = locales[locale]
const legal = kind === 'home' ? null : t.legal[kind]

const faqData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
}
---

{
  legal ? (
    <Base locale={locale} kind={kind} title={`${legal.title} | ${business.name}`} description={legal.description}>
      <article class="section legal">
        <div class="wrap">
          <h1>{legal.title}</h1>
          {legal.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          ))}
        </div>
      </article>
    </Base>
  ) : (
    <Base locale={locale} kind={kind} title={t.meta.title} description={t.meta.description} jsonLd={[faqData]}>
      <Hero locale={locale} />
      <Services locale={locale} />
      <About locale={locale} />
      <Faq locale={locale} />
      <Contact locale={locale} />
    </Base>
  )
}

<style>
  .legal .wrap {
    max-width: 46rem;
  }

  .legal h1 {
    font-size: var(--text-h2);
  }

  .legal section {
    margin-top: var(--space-block);
  }

  .legal h2 {
    font-family: var(--font-body);
    font-size: var(--text-h3);
    letter-spacing: 0;
    line-height: 1.3;
  }

  .legal p {
    margin-top: var(--space-tight);
  }
</style>
