---
import { business, locales, pathFor, type Locale } from '../content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = locales[locale]
const year = new Date().getFullYear()
---

<footer class="site-footer on-dark">
  <div class="wrap row">
    <p>© {year} {business.name}</p>
    <nav aria-label={t.ui.legalNavLabel}>
      <ul>
        <li><a href={pathFor(locale, 'imprint')}>{t.legal.imprint.title}</a></li>
        <li><a href={pathFor(locale, 'privacy')}>{t.legal.privacy.title}</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-block);
    background: var(--color-ink);
    color: var(--color-on-ink-muted);
    font-size: var(--text-small);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-group) var(--space-block);
    padding-top: var(--space-block);
    border-top: 1px solid var(--color-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-tight) var(--space-block);
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--color-on-ink);
  }
</style>
