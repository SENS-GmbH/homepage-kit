# Projekt-Einstellungen für homepage-kit. Keine Geheimnisse eintragen.
# Kommentare stehen immer in einer eigenen Zeile, nie hinter einem Wert.
# Werte mit Leerzeichen stehen in doppelten Anführungszeichen.
# Werte, die nur für einen Rechner gelten, gehören in kit.local.env (nicht versioniert).
# `npm run setup` fragt die ersten vier Werte ab und trägt sie hier ein.

# Kurzname der Website: Kleinbuchstaben, Ziffern, Bindestrich.
# Er steht im Namen der macOS-Dienste und des Wächter-Jobs.
SITE_SLUG=homepage

# Name des OpenClaw-Skills. Damit rufst du ihn im Chat auf, zum Beispiel /website.
# Leer = wie SITE_SLUG.
SKILL_NAME=

# Stichworte, bei denen der Skill auch ohne Schrägstrich-Befehl anspringen soll.
# Beispiel: SKILL_TRIGGERS="Firmenwebsite, unsere Homepage"
SKILL_TRIGGERS=

# Lokaler Port der Live-Vorschau. Pro Website auf einem Rechner einen eigenen Port wählen.
PREVIEW_PORT=4321

# Optional: zusätzlicher Port für Geräte im selben WLAN ohne Tailscale. Leer = aus.
LAN_PORT=

# Domain der fertigen Website, ohne https://. Beispiel: musterbetrieb.at
SITE_DOMAIN=

# Optional: weitere Domains, die auf SITE_DOMAIN weiterleiten. Beispiel: www.musterbetrieb.at
DOMAIN_ALIASES=

# SSH-Ziel des VPS. Beispiel: root@203.0.113.10
DEPLOY_HOST=

# Optional: Zielordner auf dem VPS. Leer = /opt/sites/<SITE_SLUG>
DEPLOY_PATH=

# Optional: Empfänger für Alarme des Vorschau-Wächters. Beispiel: telegram:123456789
WATCHDOG_ALERT_TO=
