# Projekt-Einstellungen für homepage-kit. Keine Geheimnisse eintragen.
# Kommentare stehen immer in einer eigenen Zeile, nie hinter einem Wert.
# Werte, die nur für einen Rechner gelten, gehören in kit.local.env (nicht versioniert).

# Kurzname der Website: Kleinbuchstaben, Ziffern, Bindestrich.
# Er bestimmt den Namen des OpenClaw-Skills (/homepage) und der macOS-Dienste.
SITE_SLUG=homepage

# Lokaler Port der Live-Vorschau. Pro Website auf einem Rechner einen eigenen Port wählen.
PREVIEW_PORT=4321

# Optional: zusätzlicher Port für Geräte im selben WLAN ohne Tailscale. Leer = aus.
LAN_PORT=

# Domain der fertigen Website, ohne https://. Beispiel: ordination-muster.at
SITE_DOMAIN=

# Optional: weitere Domains, die auf SITE_DOMAIN weiterleiten. Beispiel: www.ordination-muster.at
DOMAIN_ALIASES=

# SSH-Ziel des VPS. Beispiel: root@203.0.113.10
DEPLOY_HOST=

# Optional: Zielordner auf dem VPS. Leer = /opt/sites/<SITE_SLUG>
DEPLOY_PATH=

# Optional: Empfänger für Alarme des Vorschau-Wächters. Beispiel: telegram:123456789
WATCHDOG_ALERT_TO=
